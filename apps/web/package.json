{
  "name": "@link/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "db:migrate": "wrangler d1 migrations apply link-db --remote",
    "db:migrate:local": "wrangler d1 migrations apply link-db --local",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@link/db": "workspace:*",
    "@link/qr": "workspace:*",
    "@link/shared": "workspace:*",
    "better-auth": "^1.6.23",
    "drizzle-orm": "^0.45.3",
    "libphonenumber-js": "^1.13.14",
    "next": "16.3.6",
    "qr-code-styling": "^1.9.2",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.86.0"
  }
}
