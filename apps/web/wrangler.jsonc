{
  // apps/web sur Cloudflare Workers via OpenNext — qrcode.cg (bêta d'abord).
  // Déploiement : pnpm --filter @link/web deploy
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "link-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-01-15",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": { "enabled": true },

  "vars": {
    "BETTER_AUTH_URL": "https://beta.qrcode.cg",
    "CF_ACCOUNT_ID": "d173b721d701ab7804ac541a92709654"
  },
  // Secrets (wrangler secret put …) :
  //   BETTER_AUTH_SECRET   — signature des sessions
  //   CF_ANALYTICS_TOKEN   — jeton API "Account Analytics: Read" pour lire les scans

  // Le dashboard écrit les liens directement via les bindings (server actions),
  // en réutilisant @link/db — pas besoin du jeton d'admin de l'API côté serveur.
  "kv_namespaces": [
    { "binding": "LINKS", "id": "41d7ebd986a141e0a5abde505aa174e2" }
  ],
  "d1_databases": [
    { "binding": "DB", "database_name": "link-db", "database_id": "6798b00a-d331-488c-9e48-a38fb11654d1" }
  ],

  // Bêta d'abord ; bascule sur qrcode.cg une fois validé.
  "routes": [
    { "pattern": "beta.qrcode.cg", "custom_domain": true }
  ]
}
