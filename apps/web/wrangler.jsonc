{
  // apps/web sur Cloudflare Workers via OpenNext — qrcode.cg (bêta d'abord).
  // Déploiement : pnpm --filter @link/web deploy
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "link-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-01-15",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": { "enabled": true },

  "vars": {
    "BETTER_AUTH_URL": "https://beta.qrcode.cg",
    "CF_ACCOUNT_ID": "d173b721d701ab7804ac541a92709654",
    // Passer à "true" (puis redéployer) pour fermer les inscriptions.
    "DISABLE_SIGNUP": "false"
  },
  // Secrets (wrangler secret put …) :
  //   BETTER_AUTH_SECRET   — signature des sessions
  //   CF_ANALYTICS_TOKEN   — jeton API "Account Analytics: Read" pour lire les scans
  //   SAFE_BROWSING_KEY    — clé Google Safe Browsing : vérifie chaque destination de
  //                          lien (création, changement). Sans elle, rien n'est vérifié.
  //   TURNSTILE_SITE_KEY   — Turnstile (anti-robots) à l'inscription et à la connexion.
  //   TURNSTILE_SECRET_KEY   Les DEUX requises ; sans elles, ni captcha ni widget.
  //   CF_ZONE_ID           — domaines personnalisés (Cloudflare for SaaS, zone link.cg).
  //   CF_SAAS_TOKEN          Les TROIS requises ; sans elles, l'onglet Domaines
  //   CF_SAAS_CNAME_TARGET   affiche « bientôt disponible ». Voir docs/DOMAINES.md.
  //   PAWAPAY_API_TOKEN    — paiement mobile money (pawaPay). Sans lui, les offres
  //                          renvoient vers le contact commercial. PAWAPAY_ENV
  //                          ("production" pour l'API réelle, sinon sandbox) se
  //                          pose aussi en secret, pour ne pas payer en vrai en bêta.

  // Le dashboard écrit les liens directement via les bindings (server actions),
  // en réutilisant @link/db — pas besoin du jeton d'admin de l'API côté serveur.
  "kv_namespaces": [
    { "binding": "LINKS", "id": "41d7ebd986a141e0a5abde505aa174e2" }
  ],
  // Migrations : générées par Drizzle dans packages/db, appliquées par la CI avant
  // chaque déploiement (wrangler d1 migrations apply, suivi dans la table d1_migrations).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "link-db",
      "database_id": "6798b00a-d331-488c-9e48-a38fb11654d1",
      "migrations_dir": "../../packages/db/migrations"
    }
  ],

  // Configuration par défaut = bêta (branche staging).
  "routes": [
    { "pattern": "beta.qrcode.cg", "custom_domain": true }
  ],

  // Production (branche main) : Worker distinct `link-web-production` sur qrcode.cg.
  // Déploiement : opennextjs-cloudflare deploy --env production
  // Les vars et bindings ne sont pas hérités : les répéter ici. Même base et même KV
  // que la bêta (les liens et les comptes sont les mêmes).
  // Secrets à poser une fois sur ce Worker (wrangler secret put … --env production) :
  //   BETTER_AUTH_SECRET, CF_ANALYTICS_TOKEN, SAFE_BROWSING_KEY,
  //   TURNSTILE_SITE_KEY, TURNSTILE_SECRET_KEY
  "env": {
    "production": {
      "vars": {
        "BETTER_AUTH_URL": "https://qrcode.cg",
        "CF_ACCOUNT_ID": "d173b721d701ab7804ac541a92709654",
        "DISABLE_SIGNUP": "false"
      },
      "kv_namespaces": [
        { "binding": "LINKS", "id": "41d7ebd986a141e0a5abde505aa174e2" }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "link-db",
          "database_id": "6798b00a-d331-488c-9e48-a38fb11654d1",
          "migrations_dir": "../../packages/db/migrations"
        }
      ],
      // www redirige vers l'apex (next.config.ts).
      "routes": [
        { "pattern": "qrcode.cg", "custom_domain": true },
        { "pattern": "www.qrcode.cg", "custom_domain": true }
      ]
    }
  }
}
